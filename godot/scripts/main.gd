const UiDispatch=preload("res://scripts/original/original_ui_dispatch.gd")
var ui_dispatch:=UiDispatch.new()

func dispatch_ui(callback:Callable,args:Array=[])->void:
	# GUI callbacks generated by a replayed raw event remain in that message.
	if ui_dispatch.active:callback.callv(args);return
	ui_dispatch.deliver(callback,args)

func _defer_ui(callback:Callable,args:Array=[])->bool:
	if ui_dispatch.active:return false
	dispatch_ui(callback,args);return true

func _ui_dispatch_blocked()->bool:
	return dialogs.property_close_pending or model.native_presentation_is_pending()

func _ui_dispatch_after()->void:
	# Begin before another delivered message can mutate source pixel/RNG inputs.
	if not dialogs.property_close_pending and is_instance_valid(canvas):canvas._render_native_if_needed()

func _idle_dispatch()->void:
	model.tick(model.clock_milliseconds())

func _ready() -> void:
	get_tree().auto_accept_quit = false
	Input.use_accumulated_input=false
	ui_dispatch.blocked=Callable(self,"_ui_dispatch_blocked")
	ui_dispatch.after_dispatch=Callable(self,"_ui_dispatch_after")
	var input_gate:=preload("res://scripts/original/original_window_input_gate.gd").new()
	input_gate.dispatch=Callable(self,"dispatch_ui");add_child(input_gate)
	theme = _classic_theme()
	forms = read_json("res://data/forms.json")
	examples = read_json("res://data/examples.json")
	molecular_catalog = read_json("res://data/molecules.json")
	model.configure(read_json("res://data/reagents.json"), read_json("res://data/reactions.json"))
	model.fidelity_error.connect(_status)
	model.program_callback = _original_program_frame
	model.native_variable_callback = _original_chart_variables
	program.configure(model)
	program.command_requested.connect(_program_command)
	dialogs.configure(self, model)
	dialogs.status.connect(_status)
	dialogs.variable_defined.connect(func(n, id, s, metric): program.bind_variable(n, id, s, "pH" if metric == "ph" else metric); _status("已定义变量 " + n))
	dialogs.catalogs_changed.connect(func(): _dirty = true)
	if not "--testing" in OS.get_cmdline_user_args(): dialogs.load_custom_catalogs()
	_build_ui()
	model.changed.connect(func(): _dirty = true)
	for i in examples.size():
		if examples[i].name == "氢氧化铜与氢氧化铁": load_example(i); break
	if not molecular_catalog.is_empty(): _select_molecule(0)
	get_viewport().get_window().title = "仿真化学实验室 3.0 · Godot"
	if OS.has_feature("original_port_wip"):get_viewport().get_window().title += " · 原逻辑移植开发版 0.1.3"
	if "--smoke-test" in OS.get_cmdline_user_args(): call_deferred("_smoke_test")

static func read_json(path: String):
	return JSON.parse_string(FileAccess.get_file_as_string(path))

func _classic_theme() -> Theme:
	var result = Theme.new()
	result.default_font_size = 14
	for type in ["Label", "Button", "MenuButton", "PopupMenu", "LineEdit", "TextEdit", "Tree", "ItemList", "TabContainer", "OptionButton", "CheckBox", "SpinBox", "RichTextLabel"]:
		result.set_color("font_color", type, Color(0.06, 0.06, 0.06))
		result.set_color("font_focus_color", type, Color.BLACK)
		result.set_color("font_pressed_color", type, Color.BLACK)
		result.set_color("font_hover_color", type, Color.BLACK)
		result.set_color("font_disabled_color", type, Color(0.45, 0.45, 0.45))
	for type in ["Button", "OptionButton", "CheckBox"]:
		result.set_stylebox("normal", type, _box(Color(0.77, 0.77, 0.77), true))
		result.set_stylebox("hover", type, _box(Color(0.86, 0.86, 0.84), true))
		result.set_stylebox("pressed", type, _box(Color(0.69, 0.69, 0.69), false))
		result.set_stylebox("disabled", type, _box(Color(0.78, 0.78, 0.78), true))
	for type in ["LineEdit", "TextEdit", "Tree", "ItemList"]:
		result.set_stylebox("normal", type, _box(Color.WHITE, false))
		result.set_stylebox("panel", type, _box(Color.WHITE, false))
		result.set_color("font_selected_color", type, Color.WHITE)
		result.set_color("selection_color", type, Color(0.0, 0.15, 0.5))
	result.set_stylebox("panel", "Panel", _box(Color(0.77, 0.77, 0.77), true))
	result.set_stylebox("panel", "PanelContainer", _box(Color(0.77, 0.77, 0.77), true))
	result.set_stylebox("panel", "PopupMenu", _box(Color(0.78, 0.78, 0.78), true))
	result.set_stylebox("panel", "TabContainer", _box(Color(0.77, 0.77, 0.77), true))
	result.set_stylebox("tab_selected", "TabContainer", _box(Color(0.86, 0.86, 0.86), true))
	result.set_stylebox("tab_unselected", "TabContainer", _box(Color(0.73, 0.73, 0.73), true))
	for type in ["TabBar", "TabContainer"]:
		for field in ["font_selected_color", "font_unselected_color", "font_hovered_color", "font_focus_color"]: result.set_color(field, type, Color.BLACK)
	for type in ["Tree", "ItemList"]:
		result.set_stylebox("selected", type, _box(Color(0.03, 0.18, 0.48), false, 0))
		result.set_stylebox("selected_focus", type, _box(Color(0.03, 0.18, 0.48), false, 0))
	result.set_color("font_disabled_color", "TabBar", Color(0.45, 0.45, 0.45))
	result.set_color("font_placeholder_color", "LineEdit", Color(0.4, 0.4, 0.4))
	result.set_color("font_readonly_color", "TextEdit", Color.BLACK)
	result.set_color("default_color", "RichTextLabel", Color.BLACK)
	result.set_stylebox("normal", "RichTextLabel", _box(Color.WHITE, false))
	result.set_stylebox("normal", "MenuButton", _box(Color(0.77, 0.77, 0.77), true, 0))
	result.set_stylebox("hover", "MenuButton", _box(Color(0.84, 0.84, 0.84), true))
	return result

func _box(color: Color, raised: bool, width: int = 1) -> StyleBoxFlat:
	var style = StyleBoxFlat.new()
	style.bg_color = color
	style.set_border_width_all(width)
	style.border_color = Color(0.3, 0.3, 0.3)
	style.border_blend = false
	style.content_margin_left = 5
	style.content_margin_right = 5
	style.content_margin_top = 4
	style.content_margin_bottom = 4
	if raised: style.border_color = Color(0.53, 0.53, 0.53)
	return style

