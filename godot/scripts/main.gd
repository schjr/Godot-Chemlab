	dialog.dialog_text = "仿真化学实验室 3.0 · Godot 移植版\n\n原版器件、实验与化学资料\n28 个实验 · 105 个分子结构\n499 种药品 · 599 个方程式\n\n依照恢复的原程序逻辑移植；尚未移植的操作会明确提示。"
	add_child(dialog); dialog.popup_centered(); dialog.confirmed.connect(func(): dialog.queue_free())

func _request_quit() -> void:
	if _defer_ui(Callable(self,"_request_quit"),[]):return
	if not _dirty: get_tree().quit(); return
	var dialog = ConfirmationDialog.new(); dialog.title = "退出"; dialog.dialog_text = "当前实验有未保存的修改。仍然退出？"; add_child(dialog)
	dialog.confirmed.connect(func(): get_tree().quit()); dialog.canceled.connect(func(): dialog.queue_free()); dialog.popup_centered()

func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST: _request_quit()

func _unhandled_key_input(event: InputEvent) -> void:
	if not event is InputEventKey or not event.pressed: return
	var typing: bool = get_viewport().gui_get_focus_owner() is LineEdit or get_viewport().gui_get_focus_owner() is TextEdit
	if event.keycode == KEY_F1: _help_dialog(); return
	if typing: return
	if event.ctrl_pressed or event.meta_pressed:
		match event.keycode:
			KEY_N: _action("SpeedButton_newClick")
			KEY_O: _open_file()
			KEY_S: _save_or_choose()
			KEY_C: _action("Menu_copyClick")
			KEY_X: _action("Menu_cutClick")
			KEY_V: _paste()
	elif event.keycode == KEY_SPACE:
		if model.running: model.running = false
		else: run_experiment()

func _build_molecule_page() -> void:
	var page = VBoxContainer.new(); page.name = "三维分子模型"; modules.add_child(page)
	var bar = HBoxContainer.new(); page.add_child(bar)
	for mode in [["球棍", "ball-stick"], ["比例", "space-fill"], ["框架", "wireframe"], ["符号", "labels"], ["三维符号", "labels-3d"]]:
		bar.add_child(_button(mode[0], func(): molecule_view.set_display_mode(mode[1])))
	bar.add_child(_button("复位", func(): molecule_view.reset_view()))
	var rotate = CheckBox.new(); rotate.text = "自动旋转"; rotate.toggled.connect(func(value): molecule_view.set_auto_rotate(value)); bar.add_child(rotate)
	bar.add_child(_button("保存模型", _save_molecule_dialog)); bar.add_child(_button("另存为图片", _picture_dialog))
	var split = HSplitContainer.new(); split.size_flags_vertical = Control.SIZE_EXPAND_FILL; page.add_child(split)
	var left = VBoxContainer.new(); left.custom_minimum_size.x = 205; split.add_child(left)
	var search = LineEdit.new(); search.placeholder_text = "模型名称查询"; left.add_child(search)
	molecule_list = ItemList.new(); molecule_list.size_flags_vertical = Control.SIZE_EXPAND_FILL; left.add_child(molecule_list)
	search.text_changed.connect(_populate_molecule_list); _populate_molecule_list("")
	molecule_list.item_selected.connect(func(i): _select_molecule(int(molecule_indexes[i])))
	left.add_child(_button("打开模型…", func(): _create_file_dialog("打开分子模型", false, PackedStringArray(["*.cl3,*.json;分子模型", "*;原版模型"]), _open_molecule)))
	left.add_child(_button("新建模型", func(): molecule_view.set_molecule({"name": "新建模型", "atoms": [], "bonds": []}); _refresh_molecule_info()))
	var right = VBoxContainer.new(); right.size_flags_horizontal = Control.SIZE_EXPAND_FILL; split.add_child(right)
	molecule_view = Molecules.new(); molecule_view.custom_minimum_size = Vector2(450, 350); molecule_view.size_flags_horizontal = Control.SIZE_EXPAND_FILL; molecule_view.size_flags_vertical = Control.SIZE_EXPAND_FILL; right.add_child(molecule_view)
	molecule_info = Label.new(); right.add_child(molecule_info)
	var edit_bar = HBoxContainer.new(); right.add_child(edit_bar)
	edit_bar.add_child(_button("添加原子", _atom_dialog)); edit_bar.add_child(_button("编辑原子", func(): if molecule_view.selected_atom >= 0: _atom_dialog(molecule_view.selected_atom)))
	edit_bar.add_child(_button("删除原子", func(): molecule_view.delete_atom(molecule_view.selected_atom); _refresh_molecule_info()))
	edit_bar.add_child(_button("添加化学键", _bond_dialog))
	edit_bar.add_child(_button("删除键", func(): molecule_view.delete_bond(molecule_view.selected_bond); _refresh_molecule_info()))
	edit_bar.add_child(_button("单键旋转", _rotate_bond_dialog))
	molecule_view.atom_selected.connect(func(i, atom): _status("原子 %d · %s · 坐标 %s" % [i + 1, str(atom.element), str(atom.position)]))
	molecule_view.bond_selected.connect(func(i, bond): _status("化学键 %d · %s → %s" % [i + 1, str(bond.a), str(bond.b)]))

func _populate_molecule_list(query: String) -> void:
	molecule_list.clear(); molecule_indexes.clear()
	for i in molecular_catalog.size():
		if query.is_empty() or str(molecular_catalog[i].name).to_lower().contains(query.to_lower()):
			molecule_list.add_item(str(molecular_catalog[i].name)); molecule_indexes.append(i)

func _select_molecule(index: int) -> void:
	if index < 0 or index >= molecular_catalog.size(): return
	molecule_view.set_molecule(molecular_catalog[index]); _refresh_molecule_info()

func _refresh_molecule_info() -> void:
	if molecule_info != null: molecule_info.text = "%s  ·  %d 原子  ·  %d 化学键  ·  拖动旋转 / 滚轮缩放 / 点击选择" % [str(molecule_view.molecule.get("name", "分子模型")), molecule_view.molecule.atoms.size(), molecule_view.molecule.bonds.size()]

func _open_molecule(path: String) -> void:
	var doc: Dictionary = Formats.load_document(path)
	if doc.has("error") or not doc.has("atoms"): _status(str(doc.get("error", "模型数据不完整"))); return
	molecule_view.set_molecule(doc); _refresh_molecule_info(); modules.current_tab = 1

func _save_molecule_dialog() -> void:
	_create_file_dialog("保存分子模型", true, PackedStringArray(["*.molecule.json;ChemLab 分子模型"]), func(path):
		var file = FileAccess.open(path, FileAccess.WRITE)
		if file == null: _status("保存失败"); return
		file.store_string(JSON.stringify(molecule_view.molecule, "\t")); file.close(); _status("已保存分子模型"))

func _atom_dialog(index: int = -1) -> void:
	var window = _window("原子属性" if index >= 0 else "添加原子", Vector2i(420, 270)); var column = _column(window)
	var element = OptionButton.new(); column.add_child(element)
	for symbol in ["C", "H", "O", "N", "S", "P", "F", "Cl", "Br", "I", "Na", "Ca", "Fe", "Cu", "Zn", "Mg"]: element.add_item(symbol)
	var atom: Dictionary = molecule_view.molecule.atoms[index] if index >= 0 and index < molecule_view.molecule.atoms.size() else {"position": [0, 0, 0], "element": "C"}
	for i in element.item_count:
		if element.get_item_text(i) == str(atom.get("element", "C")): element.select(i)
	var coords: Array = []
	for axis in 3:
		var spin = SpinBox.new(); spin.min_value = -10000; spin.max_value = 10000; spin.step = 0.05; spin.value = float(atom.position[axis]); spin.prefix = ["X = ", "Y = ", "Z = "][axis]; column.add_child(spin); coords.append(spin)
	column.add_child(_button("确定", func():
		var position = Vector3(coords[0].value, coords[1].value, coords[2].value)
		if index >= 0:
			molecule_view.molecule.atoms[index].element = element.get_item_text(element.selected); molecule_view.set_atom_position(index, position)
		else: molecule_view.add_atom({"element": element.get_item_text(element.selected), "position": [position.x, position.y, position.z]})
		_refresh_molecule_info(); window.queue_free()))
	window.popup_centered()

func _bond_dialog() -> void:
	var window = _window("添加化学键", Vector2i(380, 210)); var column = _column(window)
	var a = SpinBox.new(); a.min_value = 1; a.max_value = maxf(1, molecule_view.molecule.atoms.size()); a.prefix = "原子 A = "; column.add_child(a)
	var b = SpinBox.new(); b.min_value = 1; b.max_value = maxf(1, molecule_view.molecule.atoms.size()); b.value = 2; b.prefix = "原子 B = "; column.add_child(b)
	var order = SpinBox.new(); order.min_value = 1; order.max_value = 3; order.prefix = "键级 = "; column.add_child(order)
	column.add_child(_button("添加", func():
		if molecule_view.add_bond(int(a.value) - 1, int(b.value) - 1, int(order.value)): window.queue_free(); _refresh_molecule_info()
		else: _status("不能添加此化学键，请检查原子编号。")))
	window.popup_centered()

func _rotate_bond_dialog() -> void:
	if molecule_view.selected_bond < 0: _status("请先在模型中点击一条单键。"); return
	var window = _window("单键旋转", Vector2i(330, 145)); var column = _column(window)
	var angle = SpinBox.new(); angle.min_value = -360; angle.max_value = 360; angle.step = 5; angle.value = 30; angle.suffix = "°"; column.add_child(angle)
	column.add_child(_button("旋转", func():
		if molecule_view.rotate_bond(molecule_view.selected_bond, angle.value): _status("已旋转单键"); window.queue_free()
		else: _status("环状键或非单键不能进行此旋转。")))
	window.popup_centered()

func _smoke_test() -> void:
	await get_tree().process_frame
	assert(model.vessels.size() > 0)
	assert(examples.size() == 28 and molecular_catalog.size() == 105)
	run_experiment(); model.step(0.3); stop_experiment()
	for i in examples.size(): assert(load_example(i))
	assert(load_example(0))
	print("PASS main scene: startup, 28 imports, run/pause/reset, 105 model catalog, menus and canvas")
	get_tree().quit()
