func _edit_original_chart(v: Dictionary) -> void:
	if not v.has("native_chart_record"):_status("曲线缺少原始设置记录。");return
	var record:Array=v.native_chart_record.duplicate()
	var window=_window("函数对象设置",Vector2i(570,440));var column=_column(window)
	var fields:Array=[]
	for entry in [[3,"横轴单位"],[4,"纵轴单位"],[5,"横轴原点"],[6,"纵轴原点"]]:
		var row:=HBoxContainer.new();column.add_child(row);var label:=Label.new();label.text=entry[1];label.custom_minimum_size.x=110;row.add_child(label)
		var edit:=LineEdit.new();edit.text=str(record[entry[0]]);edit.size_flags_horizontal=Control.SIZE_EXPAND_FILL;row.add_child(edit);fields.append([entry[0],edit])
	var series:Array=[]
	for i in range(5):
		var row:=HBoxContainer.new();column.add_child(row);var label:=Label.new();label.text="曲线%d"%(i+1);row.add_child(label)
		var x:=LineEdit.new();x.text=str(record[17+9*i]);x.placeholder_text="横轴变量";x.size_flags_horizontal=Control.SIZE_EXPAND_FILL;row.add_child(x)
		var y:=LineEdit.new();y.text=str(record[18+9*i]);y.placeholder_text="纵轴变量";y.size_flags_horizontal=Control.SIZE_EXPAND_FILL;row.add_child(y);series.append([x,y])
	column.add_child(_button("确定",func():
		for field in fields:
			if not str(field[1].text).is_valid_float():_status("轴设置需要数值。");return
			if int(field[0]) in [3,4] and float(field[1].text)==0.0:_status("轴单位不能为零。");return
			record[int(field[0])]=str(field[1].text)
		for i in range(5):record[17+9*i]=str(series[i][0].text).strip_edges();record[18+9*i]=str(series[i][1].text).strip_edges()
		var state:=preload("res://scripts/original/original_chart.gd").state_from_record(record)
		var result:=preload("res://scripts/original/original_chart.gd").initialize(state,_original_chart_variables(model.native_apparatus()))
		if not result.ok:_status(str(result.error));return
		v.native_chart_record=state.metadata;v.native_chart_state=state;v.native_chart_grid=result.grid;v.native_chart_segments=[]
		_dirty=true;canvas.queue_redraw();window.queue_free()
	));window.popup_centered()

