	buttons.add_child(_button("删除", func(): if tree.get_selected() != null: program.variables.erase(tree.get_selected().get_metadata(0)); refresh.call()))
	buttons.add_child(_button("关闭", func(): window.queue_free())); window.popup_centered()

func _program_dialog() -> void:
	var window = _window("事件程序编辑器", Vector2i(690, 480)); var column = _column(window)
	var toolbar = HBoxContainer.new(); column.add_child(toolbar)
	var editor = CodeEdit.new(); editor.text = program.code; editor.size_flags_vertical = Control.SIZE_EXPAND_FILL
	toolbar.add_child(_button("判断", func(): editor.insert_text_at_caret("判断1:如果(t>1)则执行\n\n结束判断1\n")))
	toolbar.add_child(_button("循环", func(): editor.insert_text_at_caret("循环1:当(t<1)成立\n\n结束循环1\n")))
	toolbar.add_child(_button("变量编辑器", _variable_dialog))
	column.add_child(editor)
	var hint = Label.new(); hint.text = "每帧计算，例如：ph1=-log10(1000*h1/a1)"; column.add_child(hint)
	var errors = Label.new(); errors.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART; column.add_child(errors)
	var row = HBoxContainer.new(); column.add_child(row)
	row.add_child(_button("检查", func(): program.code = editor.text; var result = program.evaluate_frame(); errors.text = "程序检查通过" if result.is_empty() else str(result[0])))
	row.add_child(_button("停止运行", func(): model.running = false))
	row.add_child(_button("确定", func():
		program.code = editor.text
		if native_program_groups.is_empty(): native_program_groups.append({"metadata":["0","3","0","0"],"lines":[]})
		native_program_groups[0].lines = editor.text.replace("\r","").split("\n",false)
		_dirty = true; window.queue_free()))
	row.add_child(_button("取消", func(): window.queue_free())); window.popup_centered()

func _program_command(command: String, arguments: Array) -> void:
	match command.to_lower():
		"restart": stop_experiment(); run_experiment()
		"quit": model.running = false
		"open": if not arguments.is_empty(): _load_path(str(arguments[0]))
		_: _status("程序命令未执行：" + command)

