func _save_path(path: String) -> bool:
	if path.get_extension().to_lower() == "cem":
		if legacy_doc.is_empty(): _status("新建实验请保存为 .chemlab.json，以完整保存器件和设置。"); return false
		var original: Dictionary = Adapter.to_state(legacy_doc)
		var current_names: Array = program.variables.keys(); current_names.sort()
		var original_names: Array = original.get("variables", {}).keys(); original_names.sort()
		if program.bindings != original.get("bindings", []) or current_names != original_names:
			_status("变量定义已修改，请保存为 .chemlab.json 以完整保留修改。"); return false
		var state: Dictionary = model.to_state(); state.program = program.code
		var doc: Dictionary = Adapter.from_state(legacy_doc, state)
		if doc.has("error"): _status(str(doc.error)); return false
		var error: Error = Formats.save_document(path, doc)
		if error != OK: _status("保存失败：" + error_string(error)); return false
		legacy_doc = doc
	else:
		var state: Dictionary = model.to_state()
		state.workspace = {"title": current_title, "legacy_document": legacy_doc, "program": program.to_state(), "annotations": canvas.annotations, "connectors": canvas.legacy_connectors}
		var file = FileAccess.open(path, FileAccess.WRITE)
		if file == null: _status("无法写入：" + error_string(FileAccess.get_open_error())); return false
		file.store_string(JSON.stringify(state, "\t")); file.close()
	current_path = path; _dirty = false; _status("已保存：" + path.get_file()); return true

