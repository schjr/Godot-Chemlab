func cleanup_deleted_chemical_bindings(original: Dictionary, edited: Dictionary) -> Dictionary:
	# Exact active-prefix projection of4A0F50/4A1050. Physical inactive rows
	# remain explicitly unknown; no300-row zero table is manufactured.
	var names: Array = []
	for species in original.contents:
		if edited.contents.has(species): continue
		if not original.get("native_binding_names",{}).has(species):
			return {"ok":false,"error":"此药品的原始变量绑定记录尚未恢复。"}
		for metric in ["moles","mass"]:
			var name:=str(original.native_binding_names[species].get(metric,""))
			if not name.is_empty():names.append(name)
	if names.is_empty():return {"ok":true}
	if native_variable_order != program.variables.keys():return {"ok":false,"error":"原始变量活动记录顺序已变化，不能验证删除操作。"}
	var order: Array=native_variable_order.duplicate();var values:Dictionary=program.variables.duplicate();var bindings:Array=program.bindings.duplicate(true)
	for name in names:
		var found:=-1
		for i in range(order.size()):
			if str(order[i]).is_empty():break
			if str(order[i])==str(name):found=i;break
		if found==-1:continue
		order.remove_at(found);values.erase(name)
		bindings=bindings.filter(func(binding):return str(binding.name)!=str(name))
	program.variables=values;program.bindings=bindings;native_variable_order=order
	return {"ok":true,"removed_names":names,"inactive_cache_boundary":inactive_variable_cache_boundary}

func _original_chart_variables(apparatus: Array) -> Dictionary:
	var values: Dictionary = program.variables.duplicate()
	for v in apparatus:
		for species in v.contents:
			for metric in ["moles","mass"]:
				for binding in program.bindings:
					if int(binding.vessel_id)==int(v.id) and str(binding.species)==str(species) and str(binding.metric)==metric:
						values[str(binding.name)] = OriginalProgramKernel.round_number(float(v.contents[species]) if metric=="moles" else float(v.native_species_mass[species]))
	program.variables = values
	var texts: Dictionary = {}
	for name in values: texts[str(name)] = OriginalProgramKernel.format_number(float(values[name]))
	return texts

func _original_program_frame(apparatus: Array, next_time: float) -> Dictionary:
	var values: Dictionary = program.variables.duplicate()
	values["t"] = OriginalProgramKernel.round_number(next_time)
	# 0048C428: native ordered species loop writes bound amount then mass.
	for v in apparatus:
		for species in v.contents:
			for metric in ["moles","mass"]:
				for binding in program.bindings:
					if int(binding.vessel_id) != int(v.id) or str(binding.species) != str(species) or str(binding.metric) != metric: continue
					var amount := float(v.contents[species]) if metric == "moles" else float(v.native_species_mass[species])
					values[str(binding.name)] = OriginalProgramKernel.round_number(amount)
	var result := OriginalProgramKernel.frame(native_program_groups,values)
	if not result.ok: return result
	# 0048C758: native programs write bound variables back, moles before mass.
	for v in apparatus:
		for species in v.contents:
			for metric in ["moles","mass"]:
				for binding in program.bindings:
					if int(binding.vessel_id) != int(v.id) or str(binding.species) != str(species) or str(binding.metric) != metric: continue
					var operand := OriginalProgramKernel.parse_number(OriginalProgramKernel.format_number(float(values[str(binding.name)])))
					if metric == "mass": operand = OriginalX87Kernel.divide(operand,float(model._species[species].molar_mass))
					v.contents[species] = maxf(0.0,OriginalX87Kernel.stored_double(operand))
	if not model.recalc(apparatus): return {"ok":false,"error":model.last_error}
	for v in apparatus:
		for species in v.contents:
			for metric in ["moles","mass"]:
				for binding in program.bindings:
					if int(binding.vessel_id) != int(v.id) or str(binding.species) != str(species) or str(binding.metric) != metric: continue
					var amount := float(v.contents[species]) if metric == "moles" else float(v.native_species_mass[species])
					values[str(binding.name)] = OriginalProgramKernel.round_number(amount)
	program.variables = values
	return {"ok":true}

