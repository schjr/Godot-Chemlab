func import_document(doc: Dictionary) -> bool:
	var state: Dictionary = Adapter.to_state(doc)
	if not model.from_state(state): _status("无法打开实验：容器数据不完整。"); return false
	legacy_doc = doc.duplicate(true); current_title = str(doc.get("name", "实验")); current_path = ""; baseline = {}
	canvas.annotations = model.annotations
	canvas.legacy_connectors = model.native_connectors
	canvas.graph_history.clear()
	program.from_state({"variables": state.get("variables", {"t": 0}), "bindings": state.get("bindings", []), "code": state.get("program", "")})
	native_variable_order = []
	for row in state.get("legacy_variables",[]): native_variable_order.append(str(row.name))
	native_program_groups = state.program_groups.duplicate(true)
	if not model.initialize_charts(): return false
	for v in model.vessels: v.hide_label = not canvas.annotations.is_empty()
	selected_id = -1; canvas.selected_id = -1; canvas.reset_native_selection(); _dirty = false
	canvas.call_deferred("fit_document"); _status("已打开原版实验：" + current_title)
	return true

