func _add_menu(parent: Control, definition: Dictionary) -> void:
	var menu = MenuButton.new(); menu.text = _caption(str(definition.properties.get("Caption", "")))
	parent.add_child(menu)
	if definition.name not in ["Menu_file", "Menu_help"]: _lab_menus.append(menu)
	var popup = menu.get_popup(); popup.theme = theme
	for item in definition.children:
		var p: Dictionary = item.properties
		if p.get("Visible", true) == false: continue
		var caption: String = _caption(str(p.get("Caption", "")))
		if caption == "-": popup.add_separator(); continue
		var index: int = popup.item_count
		popup.add_item(caption, index)
		var handler: String = str(p.get("OnClick", ""))
		popup.set_item_metadata(index, handler)
		if handler in UNPORTED:
			popup.set_item_disabled(index, true)
			popup.set_item_tooltip(index, "原版 Windows 发布与外部服务功能；详见项目功能对照表")
	popup.id_pressed.connect(func(id): _action(str(popup.get_item_metadata(popup.get_item_index(id)))))

func _caption(text: String) -> String:
	return text.replace("&", "")

func _build_toolbar() -> void:
	var form: Dictionary = forms["_main/TFORM1"]
	for child in form.children[0].children:
		if child["class"] == "TBevel":
			var sep = VSeparator.new(); lab_toolbar.add_child(sep); continue
		var p: Dictionary = child.properties
		var handler: String = str(p.get("OnClick", ""))
		var b = Button.new(); b.custom_minimum_size = Vector2(32, 32)
		b.tooltip_text = str(p.get("Hint", ""))
		if p.has("Glyph.Data") and ResourceLoader.exists(p["Glyph.Data"]): b.icon = load(p["Glyph.Data"])
		else: b.text = "+" if child.name == "SpeedButton28" else "−"
		b.pressed.connect(func(): _action(handler))
		b.disabled = handler in UNPORTED
		lab_toolbar.add_child(b)
		if child.name == "SpeedButton19": _run_button = b
		elif child.name == "SpeedButton20": _stop_button = b
		elif child.name == "SpeedButton21": _pause_button = b
	var space = Control.new(); space.size_flags_horizontal = Control.SIZE_EXPAND_FILL; lab_toolbar.add_child(space)
	lab_toolbar.add_child(_button("添加药品", func(): _ensure_selection(); if selected_id >= 0: dialogs.show_add_reagent(selected_id)))
	lab_toolbar.add_child(_button("属性", func(): _ensure_selection(); _properties(selected_id)))

func _build_palette() -> void:
	palette = Control.new(); palette.custom_minimum_size = Vector2(78, 475); palette.size_flags_vertical = Control.SIZE_EXPAND_FILL; lab_body.add_child(palette)
	var data: Array = read_json("res://data/toolbar.json")
	for p in data:
		var b = Button.new()
		b.position = Vector2(float(p.get("Left", 0)), float(p.get("Top", 0))) * 1.24
		b.size = Vector2(float(p.get("Width", 25)), float(p.get("Height", 25))) * 1.24
		b.custom_minimum_size = b.size
		b.tooltip_text = str(p.get("Hint", "选择 / 移动"))
		if p.has("Glyph.Data") and ResourceLoader.exists(p["Glyph.Data"]): b.icon = load(p["Glyph.Data"])
		else: b.text = str(p.get("Caption", "▱"))
		b.pressed.connect(func(): _choose_equipment(str(p.name), str(p.get("Hint", "选择 / 移动"))))
		palette.add_child(b)

func _choose_equipment(name: String, caption: String) -> void:
	if name == "SpeedButton0": canvas.set_tool("select"); _status("选择 / 移动"); return
	if not EQUIPMENT.has(name): return
	current_equipment = EQUIPMENT[name].duplicate()
	if name in ["SpeedButton1", "SpeedButton2", "SpeedButton6"]:
		var choices: Array = [["100ml", "sb100", 100], ["200ml", "sb200", 200], ["500ml", "sb500", 500]]
		if name == "SpeedButton2": choices = [["100ml", "zxp100", 100], ["250ml", "zxp250", 250]]
		if name == "SpeedButton6": choices = [["直立", "sg0", 50], ["倾斜45°", "sg45", 50], ["水平", "sg97", 50]]
		var popup = PopupMenu.new(); popup.theme = theme; add_child(popup)
		for c in choices: popup.add_item(str(c[0]))
		popup.id_pressed.connect(func(i): current_equipment[0] = choices[i][1]; current_equipment[2] = choices[i][2]; canvas.set_tool(current_equipment[0]); _status(caption + "：点击实验区放置"))
		popup.popup_hide.connect(func(): popup.queue_free())
		popup.position = Vector2i(get_global_mouse_position()); popup.popup(); return
	canvas.set_tool(str(current_equipment[0])); _status(caption + "：点击实验区放置")

func _button(text: String, callback: Callable) -> Button:
	var button = Button.new(); button.text = text; button.pressed.connect(callback); return button

func _window(title: String, dimensions: Vector2i) -> Window:
	var window = Window.new(); window.title = title; window.size = dimensions; window.theme = theme
	window.transient = true; window.exclusive = false; window.unresizable = false
	window.close_requested.connect(func(): window.queue_free()); add_child(window)
	return window

func _column(window: Window) -> VBoxContainer:
	var margin = MarginContainer.new(); margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	for name in ["margin_left", "margin_top", "margin_right", "margin_bottom"]: margin.add_theme_constant_override(name, 10)
	window.add_child(margin)
	var column = VBoxContainer.new(); margin.add_child(column); return column

func _status(message: String) -> void:
	if status_label != null: status_label.text = message

func _select_apparatus(id: int) -> void:
	selected_id = id
	canvas.selected_id = id
	var vessel: Dictionary = model.get_vessel(id)
	if not vessel.is_empty(): _status("%s · 容量 %.0f ml · %.2f°C · 双击属性 / 右键操作" % [vessel.label, float(vessel.volume_ml), float(vessel.temperature)])

func _ensure_selection() -> void:
	if selected_id >= 0 and not model.get_vessel(selected_id).is_empty(): return
	if not model.vessels.is_empty(): _select_apparatus(int(model.vessels[0].id))
	else: _status("请先从器件箱放置一个容器。")

func _add_apparatus(kind: String, location: Vector2) -> void:
	var vessel: Dictionary = model.add_apparatus(kind, location)
	if vessel.is_empty(): return
	_select_apparatus(int(vessel.id)); _dirty = true

func _properties(id: int) -> void:
	if _defer_ui(Callable(self,"_properties"),[id]):return
	var v: Dictionary = model.get_vessel(id)
	if v.is_empty(): return
	if v.kind in ["annotation", "chart", "button", "image"]: _edit_decoration(v); return
	dialogs.show_properties(id)

func _show_context(id: int, location: Vector2) -> void:
	_select_apparatus(id)
	_populate_context(model.get_vessel(id))
	# Canvas emits viewport coordinates. Native popup windows use screen pixels,
	# including the window origin and stretch/HiDPI transform.
	var popup_point:Vector2=location if context_menu.is_embedded() else get_viewport().get_screen_transform()*location
	context_menu.position = Vector2i(popup_point); context_menu.popup()

func _original_pour_visible(v: Dictionary) -> bool:
	# Original43F008, N18 is Form+448 (retained TForm1 field table).
	var fields: Dictionary = v.get("native_fields",{})
	if not fields.has("0x08") or not fields.has("0x0c") or not fields.has("0x38"): return false
	if int(fields["0x38"]) != 0: return false
	var typ := int(fields["0x08"])
	return typ in [102,103,104,105,106,121,201,202] or (typ == 101 and int(fields["0x0c"]) in [0,45])

func _populate_context(v: Dictionary) -> void:
	context_menu.clear()
	for action in CONTEXT_LABELS.size():
		if action == 2 and not _original_pour_visible(v): continue
		context_menu.add_item(CONTEXT_LABELS[action],action)
	var index := context_menu.get_item_index(2)
	if index >= 0:
		var orientation := int(v.native_fields["0x18"])
		if orientation in [0,2]: _pour_menu_checked = orientation == 2
		context_menu.set_item_checked(index,_pour_menu_checked)

func _context_action(action: int) -> void:
	if _defer_ui(Callable(self,"_context_action"),[action]):return
	var v: Dictionary = model.get_vessel(selected_id)
	if v.is_empty(): return
	match action:
		0: dialogs.show_add_reagent(selected_id)
		1: _properties(selected_id)
		2:
			if _original_pour_visible(v): model.toggle_pour(selected_id)
		3: _status("原版加热由酒精灯的位置和盖状态决定。")
		4:
			if int(v.type_id) == 302:
				v.native_fields["0x38"] = "0" if int(v.native_fields["0x38"]) == 1 else "1"
				model._bind_native(v); model.changed.emit()
			else: _status("此器件的原版点燃操作尚未完成移植。")
		5: _status("原版塞子交互尚未完成移植。")
		6: _connect_vessels()
		7: copied_vessel = v.duplicate(true); _status("已复制 " + str(v.label))
		8: model.remove_apparatus(selected_id); selected_id = -1

func _connect_vessels() -> void:
	_status("原版导管创建交互尚未完成移植，现有实验导管保留原始状态。")

func _action(handler: String) -> void:
	if _defer_ui(Callable(self,"_action"),[handler]):return
	match handler:
		"SpeedButton_newClick":
			if modules.current_tab == 1: molecule_view.set_molecule({"name": "新建模型", "atoms": [], "bonds": []}); _refresh_molecule_info()
			elif modules.current_tab == 2: _status("请使用“新增资料”创建资料。")
			else: new_experiment()
		"SpeedButton_openClick": _open_file()
		"N33Click":
			if modules.current_tab == 0: show_examples()
			elif modules.current_tab == 1: molecule_list.grab_focus()
			else: _status("请在左侧资料列表中选择资料。")
		"SpeedButton_saveClick": _save_or_choose()
		"Menu_save_asClick":
			if modules.current_tab == 1: _save_molecule_dialog()
