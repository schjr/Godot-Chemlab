	baseline = {}; baseline_program = {}; canvas.annotations = model.annotations; canvas.legacy_connectors = model.native_connectors; canvas.reset_native_selection(); canvas.graph_history.clear(); _status("实验已停止，恢复运行前的状态。")

func _process(delta: float) -> void:
	ui_dispatch.drain()
	# A Godot frame is only a polling opportunity, not a delivered timer message.
	# Never accumulate polls while the original callback/drawing is still busy.
	if ui_dispatch.queue.is_empty() and not _ui_dispatch_blocked():dispatch_ui(Callable(self,"_idle_dispatch"))
	if not ui_dispatch.error.is_empty():_status(ui_dispatch.error)
	if time_label != null: time_label.text = ("运行" if model.running else "准备") + "  t = %.2f s" % model.elapsed
	if title_label != null: title_label.text = current_title + (" *" if _dirty else "") + "  "
	if _run_button != null:
		_run_button.disabled = model.running or model.paused
		_stop_button.disabled = baseline.is_empty()
		_pause_button.disabled = baseline.is_empty()

