extends SceneTree
const Vm=preload("res://scripts/original/original_particle_vm.gd")
const Frame=preload("res://scripts/original/original_particle_frame.gd")
var failures:Array=[]
var checks:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures.append(label)
func _initialize()->void:
	var vm=Vm.new()
	vm.map_zero(0x1000,0x10000)
	check(vm.memory.is_empty() and vm.zero_spans==[[0x1000,0x11000]],"known explicit zeros use one interval without per-byte Dictionary entries")
	check(vm.contains_span(0x1000,0x10000),"entire zero interval known")
	check(vm.read(0x10ffc,4)==PackedByteArray([0,0,0,0]),"source zero end bytes readable")
	check(not vm.contains_span(0xfff,2) and not vm.contains_span(0x10fff,2),"out-of-range bytes stay unknown")
	check(vm.read(0x11000,1).is_empty() and vm.error.contains("undefined native byte"),"unknown read still fails")
	vm.error="";vm.put(0x2000,0x44332211)
	check(vm.read(0x1fff,6)==PackedByteArray([0,0x11,0x22,0x33,0x44,0]),"sparse writes override known zeros only at written bytes")
	vm.put(0x12000,0x77,1)
	vm.map_zero(0x2001,2)
	check(vm.read(0x2000,4)==PackedByteArray([0x11,0,0,0x44]),"repeated explicit zero resets previous writes inside span")
	check(vm.integer(0x12000,1)==0x77,"reused zero span leaves outside writes untouched")
	vm.map_zero(0x11000,0x1000)
	check(vm.zero_spans==[[0x1000,0x12000]],"adjacent explicit zero spans merge")
	vm.map_zero(0x500,0x100)
	check(vm.zero_spans==[[0x500,0x600],[0x1000,0x12000]],"separated spans keep intervening bytes unknown")
	check(vm.overlaps_known_span(0xfff,2) and vm.overlaps_known_span(0x11fff,2),"alias guard detects any zero bytes in partial overlaps")
	check(vm.overlaps_known_span(0x12000,1),"alias guard detects sparse observed bytes outside zeros")
	check(not vm.overlaps_known_span(0x600,0x100),"alias guard permits genuinely unknown interval")
	var partial=Vm.new();partial.map_zero(0x1ff8,16)
	check(partial.contains_span(0x1ff8,16) and not partial.has_byte(0x1ff7) and not partial.has_byte(0x2008),"partial zero-page cache keeps both page boundaries exact")
	partial.map_zero(0x1800,0x1000)
	check(partial.contains_span(0x1800,0x1000) and not partial.has_byte(0x17ff) and not partial.has_byte(0x2800),"expanded overlapping partial pages retain exact extent")
	partial.map_zero(0x1000,0x2000)
	check(partial.zero_pages[0x1000] is bool and partial.zero_pages[0x2000] is bool and partial.contains_span(0x1000,0x2000),"merged partial pages promote to constant-time full-page markers")
	vm.map_zero(0xffffffff,2)
	check(not vm.error.is_empty() and not vm.has_byte(0xffffffff),"invalid DWORD range rejected without mapping bytes")
	var frame=Frame.new();frame.vm=Vm.new()
	var p:int=frame._alloc(0x3468c,true)
	check(p==0x1000000 and frame.vm.memory.is_empty(),"real solid InitInstance allocation is compact")
	check(frame.vm.contains_span(p,0x3468c) and not frame.vm.has_byte(p+0x3468c),"real solid allocation exposes exact zero extent only")
	var raw:int=frame._alloc(0x4348,false)
	check(not frame.vm.has_byte(raw) and not frame.vm.contains_span(raw,0x4348),"plain apparatus allocation is never implicitly zeroed")
	print(JSON.stringify({"checks":checks,"failures":failures}))
	if failures.is_empty():print("PASS compact source-zero particle memory preserves unknowns writes reset boundaries and aliases")
	quit(0 if failures.is_empty() else 1)
